{
  "name": "git-manager-ui-clone",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wails dev",
    "build": "wails build",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:format": "node scripts/check-format.mjs",
    "check": "npm run check:format && npm run typecheck && npm test && npm run web:build && go vet ./... && go test ./... -count=1",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.{ts,tsx}\" && node --test scripts/check-format.test.mjs",
    "wails:dev": "wails dev",
    "wails:build": "wails build"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lucide-react": "0.487.0",
    "marked": "^18.0.14",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
